+  if (code.startsWith("DESKTOP_RUNTIME_PROXY_FAILED")) return "Nie zatwierdzono: zapis trwał zbyt długo. Spróbuj ponownie.";
+  return `Nie zatwierdzono pliku. Spróbuj ponownie. Kod: ${reason || code}`;
+}
