{
  "bundle": {
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "signCommand": {
        "cmd": "powershell.exe",
        "args": [
          "-NoProfile",
          "-NonInteractive",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "../../installer/tauri-sign-command.ps1",
          "%1"
        ]
      }
    },
    "resources": {
      "runtime": "runtime"
    }
  }
}
