{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lex Machina",
  "version": "0.1.7",
  "identifier": "pl.lexmachina.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../lex-web run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm --prefix ../lex-web run build",
    "frontendDist": "../../lex-web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lex Machina",
        "width": 1440,
        "height": 960,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://lex-api.localhost lex-api://localhost; img-src 'self' data: blob:; frame-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Polish",
          "English"
        ],
        "installerHooks": "./windows/hooks.nsh",
        "customLanguageFiles": {
          "Polish": "./windows/Polish.nsh"
        },
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
